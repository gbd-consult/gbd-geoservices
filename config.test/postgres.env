# The database's name, owner and password, for both postgres (which creates
# them when it initialises an empty pgdata) and the app (lib/config.py hands
# them to libpq). A copy of config.local/'s: the test stack connects to the dev
# stack's database. Tracked, so the dev password only.
POSTGRES_DB=geoservices
POSTGRES_USER=geoservices
POSTGRES_PASSWORD=geoservices
