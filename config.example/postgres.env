# The database's name, owner and password, for both postgres (which creates
# them when it initialises an empty pgdata) and the app (lib/config.py hands
# them to libpq). Template for config/postgres.env -- see README.md.
POSTGRES_DB=geoservices
POSTGRES_USER=geoservices
POSTGRES_PASSWORD=CHANGEME
# The key of the HMAC the trial key form stores e-mail addresses under
# (lib/keys.py). Any long random string: openssl rand -hex 32. Changing it
# forgets which addresses already had a trial key.
TRIAL_EMAIL_SECRET=CHANGEME
